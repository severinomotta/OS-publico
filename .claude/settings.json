{
  "permissions": {
    "allow": [
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(python scripts/*)",
      "Bash(node .claude/hooks/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-git.js\" 2>/dev/null; node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.js\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Sincronizando com o GitHub e carregando To-dos..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/user-prompt-submit.js\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
